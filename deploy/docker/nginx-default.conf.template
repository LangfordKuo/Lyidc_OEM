# Lyidc_OEM 前端站点配置模板。
# nginx 官方镜像 entrypoint 会用 envsubst 渲染本文件（见 Dockerfile.frontend），
# 只有 ${...} 形式会被替换，nginx 自身的 $host / $uri 等变量不受影响。
# 可用变量：BACKEND_UPSTREAM（缺省 http://backend:8080）。

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # 前端产物是文本资源，压缩收益明显。
    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 带内容指纹的构建产物可长缓存。
    #
    # 安全响应头（P5 安全整改 finding#14 / #18，契约 1.3）必须在这里**再写一遍**：
    # nginx 的 add_header 只要在当前层级出现过，父层级的同名指令就**不再继承**，
    # 而本块自带 Cache-Control，所以不重复写就会让 /assets/* 的响应丢掉全部安全头。
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    # 后端 API（会员端/管理端/支付回调/健康检查）。
    # 必须命中后端：若这里漏配或写错地址，请求会退化成静态站点 404/502，而不是后端 JSON。
    #
    # 本块**刻意不写** add_header：这些请求由 Go 后端处理，6 个安全响应头由后端中间件设置
    # （internal/securityheaders）。nginx 再写一遍会让同名头出现两行，虽然值一致但没必要。
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 安装向导（由后端内嵌页面提供）：首次部署从这里进入，装完自动关闭。
    # 同 /api/：安全头由后端设置，nginx 不重复写。
    location /install {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA 路由回退：前台/会员中心/管理后台都是前端路由，刷新时交回 index.html。
    #
    # 安全响应头（P5 安全整改 finding#14 / #18，契约 1.3）：前端产物由 nginx 直出、不经 Go，
    # 因此必须在这里也加上同值的 6 个头。`always` 让 4xx/5xx（如 try_files 兜底的 404）也带上。
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri/ /index.html;
    }
}
