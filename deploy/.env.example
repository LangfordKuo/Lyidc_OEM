# deploy/.env 示例：cp .env.example .env 后按需修改（docker compose 自动读取同目录 .env）。
# .env 已加入 .gitignore，不会被提交。

# ---- 必填 ----
# MySQL root 口令。安装向导第 2 步的「数据库口令」要填同一个值。
# 生产环境请改成足够随机的强口令。
MYSQL_ROOT_PASSWORD=change-me-strong-password

# ---- 常用可选 ----
# 前端对外端口：浏览器打开 http://<主机>:<该端口>/install
LYIDC_HTTP_PORT=8088

# 容器时区（影响日志时间戳与到期扫描判定）
TZ=Asia/Shanghai

# ---- 镜像地址 ----
# 默认取 GHCR latest。国内网络可换成加速前缀（见 docs/deploy.md「国内镜像加速」），
# 例如：LYIDC_BACKEND_IMAGE=docker.m.daocloud.io/ghcr.io/langfordkuo/lyidc-oem-backend:latest
# 也可以固定到某个版本（推荐生产环境这样做），例如 .../lyidc-oem-backend:v1.0.0
LYIDC_BACKEND_IMAGE=ghcr.io/langfordkuo/lyidc-oem-backend:latest
LYIDC_FRONTEND_IMAGE=ghcr.io/langfordkuo/lyidc-oem-frontend:latest
