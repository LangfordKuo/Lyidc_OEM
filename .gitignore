.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# ---- 工具与临时文件 ----
.codex-*/
.claude-*/
# 一键升级（R13-B）在安装目录落下的运行资产；若从仓库目录直接跑起来会出现在这里
upgrade-state.json
.upgrade/
# 数据库备份（R14）的缺省目录：与 dist/ 同级、绝不在 Web 根内；从仓库目录直接跑起来会落在这里
backups/
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
tmp/
scratch/
/deploy/.env
/build/

# ---- Python（自检脚本的字节码缓存）----
__pycache__/
*.pyc

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*
